# ============================================================================
# Credentials. These four are all a default install needs; the rest of the file
# is optional tuning.
#
# The values are left EMPTY rather than filled with something like
# `your-livekit-api-key`, and that is load-bearing rather than tidiness. Every
# credential check in the product -- the setup gate, the keyring probe, the
# worker's own read of this file -- treats "the variable holds a non-empty
# string" as "you have this key", because telling a placeholder from a real key
# would cost a billable request. A shipped placeholder therefore reads as a
# working credential: the gate says you are ready and the first turn is a 401.
#
# An empty value is a real absence, and it leaves the line there to paste into.
# ============================================================================

# Project URL, from https://cloud.livekit.io/ -- starts with wss:// for a cloud
# project and ws:// for a local server.
LIVEKIT_URL=
# Under Settings -> API Keys in the same project.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Select the native Gemini Live profile or the preserved legacy cascade.
# gemini_live is the default and the one that needs no other credential: one
# realtime model hears, thinks and speaks, so the cascade's Groq and Cartesia
# keys are not required.
LUMINE_PIPELINE=gemini_live
# LUMINE_PIPELINE=legacy_cascade

# Gemini Live (backend-only; never expose this as VITE_*).
# From https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Sulafat
GEMINI_LANGUAGE=en
# No default is shipped, and there is deliberately no fallback in the code either.
# `gemini-3.8-live`, the model above, is not configured by thinking level at all --
# Google rejects `thinking_config` for it, and a session that sets one fails at
# setup with no audio. Leaving this unset is correct for that model.
#
# To reason more deeply, switch GEMINI_MODEL to gemini-3.8-live-extended-thinking,
# which is configured by level and whose only levels are low, medium and high.
# `minimal` is not one of them.
# GEMINI_THINKING_LEVEL=low
# GEMINI_INCLUDE_THOUGHTS=false
GEMINI_MAX_OUTPUT_TOKENS=1024
# Keep provider retries low; tune only after measuring latency.
GEMINI_CONNECT_MAX_RETRY=0
GEMINI_CONNECT_TIMEOUT=10
GEMINI_MAX_TOOL_STEPS=1
# Fallback when a session is dispatched without UI metadata.
LUMINE_INTERRUPTION_MODE=barge_in

# Legacy Groq/Silero/Cartesia settings, only for LUMINE_PIPELINE=legacy_cascade.
# The default pipeline above is `gemini_live`, so you do not need these unless you
# switch the cascade on.
# GROQ_API_KEY=
# CARTESIA_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cartesia speech synthesis. The model is overridable so a deprecated model is a
# one-line change; the default must never be a retired model. See
# agent/providers.py for the curated list and agent/validation.py for the rules.
# sonic-2 was removed as a default because Cartesia retires it on 2026-10-20.
# CARTESIA_TTS_MODEL=sonic-3
# CARTESIA_TTS_VOICE=002622d8-19d0-4567-a16a-f99c7397c062
# CARTESIA_TTS_LANGUAGE=en
# CARTESIA_TTS_SPEED=0.95

# Voice LLM budget. Cap completion tokens so an ordinary reply cannot request
# thousands of tokens and trip the per-minute token limit.
#
# 900 is also the code default, and it is the floor that matters rather than the
# ceiling. `openai/gpt-oss-20b` is a *reasoning* model: it draws its thinking from
# this same budget, so a cap low enough to be "generous for a chat reply" leaves
# nothing to say the answer with. The result is a turn that produces an internal
# monologue and no audio, which is indistinguishable from a muted microphone. If
# you raise this, check the voice still starts.
GROQ_MAX_COMPLETION_TOKENS=900
GROQ_TEMPERATURE=0.7
# Provider-level retries, and LiveKit-level completion retries
# (attempts = GROQ_CONNECT_MAX_RETRY + 1). Both are clamped to 2 or lower.
GROQ_MAX_RETRIES=2
GROQ_CONNECT_MAX_RETRY=1

# Optional when Tauri should use a specific Python executable.
# LUMINE_PYTHON_BIN=C:\path\to\python.exe

# OpenAI. The plugin is installed and the settings screen will offer its models,
# but no default profile uses one, so this stays empty until you select an OpenAI
# model on the Language tab. The local-model provider under the same plugin needs
# no key at all and is not configured here.
# From https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Tool toggles for the voice agent. Tool ids live in agent/tools/tools_registry.py.
#
# These are the *file* form. The same switches are in the app on the Tools page,
# and the saved document wins over these per key -- so a switch flipped in the app
# is not quietly undone by a line here. Prefer the app; keep these for a machine
# nobody opens the app on.
#
#   {"tools": {"browse": "off", "open_app": "on"}}
#
# in lumine.config.json, or use LUMINE_DISABLED_TOOLS below. An unrecognised value
# is read as "on", because this key only ever reduces what Lumine can do.
# LUMINE_DISABLED_TOOLS=weather,news
# LUMINE_ENABLE_APP_LAUNCH=false
# Whether `desktop_control` may move the mouse and press keys. OFF unless you
# turn it on, in either this variable or `desktop.input` in lumine.config.json
# (the document wins per key). This is the widest capability in the product:
# it can click any pixel and press any named key, in any application. It is
# deliberately not part of LUMINE_ENABLE_APP_LAUNCH -- launching a program and
# driving one are different amounts of authority -- and it refuses to drive
# its own window, so it cannot be used to switch itself back on.
# LUMINE_ENABLE_DESKTOP_INPUT=false
# Seconds during which asking for the same app again does not open a second
# window of it. Notepad and NOTEPAD.exe count as one app. 0 turns this off.
# LUMINE_LAUNCH_DEDUP_SECONDS=10
# How long the installed-app index is trusted before it is rebuilt (seconds,
# clamped 15-3600). A miss after a fresh install may rebuild sooner, at most
# once every 20 seconds.
# LUMINE_APP_INDEX_TTL=300

# The browsing tools. `browse` drives a page by its own references; `web_control`
# finds a control by what it is, and adds `search` for a page's own search box and
# `screenshot` for a picture of the page. A screenshot always reaches the app as a
# preview; it reaches Lumine herself only when the model asks, because a picture in
# her context is paid for again on every later turn of the conversation.
#
# Its engine is installed once, separately, because it is a ~150 MB browser rather
# than a library:
#   python -m playwright install chromium
# LUMINE_ENABLE_BROWSER=false
# Where its isolated profile lives (its own cookies -- never your real
# browser's). A login you complete by typing it in that window survives
# between conversations.
# LUMINE_BROWSER_PROFILE=C:\path\to\lumine-browser-profile
# true runs it without showing the window. Default is shown, so you can watch
# exactly what Lumine does.
# LUMINE_BROWSER_HEADLESS=false
# true allows pages on localhost and your home network's addresses. Off by
# default: a page must not be able to aim the browser at your router through
# the assistant.
# LUMINE_BROWSER_ALLOW_LOCAL=false

# WhatsApp messaging. off sends nothing and hides the tools; deeplink (the
# default) opens your own WhatsApp app with the recipient and text filled in
# and YOU press send; automation drives WhatsApp Web in Lumine's browser --
# sign in once by scanning the QR code, and that login lives in the isolated
# browser profile. The saved settings document (messaging.whatsapp.mode) wins
# over this variable, and an unrecognised value is treated as off.
# LUMINE_WHATSAPP_MODE=deeplink
# Seconds during which the same message to the same number is not prepared
# or sent twice. 0 turns this off.
# LUMINE_WHATSAPP_DEDUP_SECONDS=10
# Whether Lumine may read a chat's messages. ask (the default) asks once per
# conversation and says out loud that the permission lasts the rest of it; off
# reads nothing at all; auto never asks. A document key of messaging.whatsapp.history
# wins over this variable, and an unrecognised value is treated as ask.
# LUMINE_WHATSAPP_HISTORY=ask
# Folders Lumine may attach a file from. A model-supplied path is checked against
# these -- resolve first, then compare -- so "attach C:\Users\me\.ssh\id_rsa" is
# refused rather than sent. Separate them with your system's path separator.
# Defaults to your Downloads, Pictures and Desktop when unset.
# LUMINE_ATTACH_ROOTS=C:\Users\you\Downloads;C:\Users\you\Pictures

# The music library. One folder Lumine may play from; the file is handed to
# whatever player your computer already uses, so nothing is installed. A
# subfolder is a playlist, so "play my vocal songs" plays everything in one called
# `vocal`, in the order a file manager shows.
#
# Prefer the Settings screen (Music), which picks the folder with the system's
# own picker and reports how many tracks are in it. The saved document keys
# `media.enabled` and `media.library` win over both variables below.
#
# OFF by default, and worth leaving off until you mean it: a song Lumine starts
# keeps playing when the call ends. She cannot stop it from here -- the player's
# own window owns playback -- so there is no switch for what she has already
# started. An unrecognised value is treated as off, the opposite of the per-tool
# switches, because this one grants a capability rather than reducing one.
# LUMINE_ENABLE_MEDIA=false
# The library folder. Every path is checked by resolving it first and then
# comparing against this root, so `..`, an absolute path and a symlink pointing
# out are all refused -- and only audio and video extensions are playable, never
# an executable, an archive or a playlist file.
# LUMINE_MEDIA_LIBRARY=C:\Users\you\Music
# false searches only what is directly in the folder, ignoring subfolders. On by
# default, because a folder called `vocal` is nearly always inside another one.
# LUMINE_MEDIA_RECURSIVE=true
# Narrows the playable extensions. It can only REMOVE extensions from the list,
# never add one, so this cannot be used to widen what Lumine will open.
# LUMINE_MEDIA_EXTENSIONS=.mp3,.m4a,.flac,.wav,.opus,.mp4,.mkv

# Per-tool approval levels, as tool=level pairs. The levels are default, ask
# and off. "default" means the action's own class decides: reading is
# automatic, sensitive and destructive actions ask no matter what this says --
# this file can only make Lumine ask MORE often, never less. An unrecognised
# level is treated as "ask", never as automatic. A key may also name one verb
# of a tool to tighten that verb alone; every other verb keeps the tool's own
# level.
# LUMINE_PERMISSIONS=open_app=ask,browse=off,manage_window.close=ask
# Seconds a pending approval waits before it refuses itself (clamped 5-120,
# default 60).
# LUMINE_PERMISSION_TIMEOUT=60
# Where approval decisions are appended, one JSON line each. Defaults to the
# desktop app's local data directory.
# LUMINE_AUDIT_PATH=C:\path\to\lumine_audit.jsonl
# Whether Lumine SPEAKS a pending approval question as well as showing the card.
# On by default: this is a voice conversation, and a card in the corner of a
# window is a question nobody notices. Turning it off changes only the
# announcement -- the action is still asked for, still waits, and still refuses on
# silence. The card always carries the exact recipient and wording; the spoken
# question never joins the conversation context, so the model cannot read its own
# approval request back as consent.
# LUMINE_VOICE_APPROVAL=true

# ---- Routing preferences -----------------------------------------------------
# What "open a website" means when the request names no website. With neither of
# these set, Lumine asks rather than opening something you did not ask for.
# The saved settings document (desktop.browsers) wins over both; see
# agent/settings/validation.py for the schema.
# Your own desktop browser, e.g. chrome, edge, firefox. Lumine can launch and
# focus it but cannot navigate it.
# LUMINE_DEFAULT_BROWSER=chrome
# Lumine's own isolated browser instead, which she can actually drive. Prefer this
# over the above when you mostly want her to *use* pages rather than open them.
# LUMINE_PREFER_OWN_BROWSER=true
