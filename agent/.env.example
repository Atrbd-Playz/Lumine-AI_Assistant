# ============================================================================
# Credentials. These four are all a default install needs; the rest of the file
# is optional tuning.
#
# The values are left EMPTY rather than filled with something like
# `your-livekit-api-key`, and that is load-bearing rather than tidiness. Every
# credential check in the product -- the setup gate, the keyring probe, the
# worker's own read of this file -- treats "the variable holds a non-empty
# string" as "you have this key", because telling a placeholder from a real key
# would cost a billable request. A shipped placeholder therefore reads as a
# working credential: the gate says you are ready and the first turn is a 401.
#
# An empty value is a real absence, and it leaves the line there to paste into.
# ============================================================================

# Project URL, from https://cloud.livekit.io/ -- starts with wss:// for a cloud
# project and ws:// for a local server.
LIVEKIT_URL=
# Under Settings -> API Keys in the same project.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Select the native Gemini Live profile or the preserved legacy cascade.
# gemini_live is the default and the one that needs no other credential: one
# realtime model hears, thinks and speaks, so the cascade's Groq and Cartesia
# keys are not required.
LUMINE_PIPELINE=gemini_live
# LUMINE_PIPELINE=legacy_cascade

# Gemini Live (backend-only; never expose this as VITE_*).
# From https://aistudio.google.com/apikey
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-live
GEMINI_VOICE=Sulafat
GEMINI_LANGUAGE=en
# No default is shipped, and there is deliberately no fallback in the code either.
# `gemini-3.8-live`, the model above, is not configured by thinking level at all --
# Google rejects `thinking_config` for it, and a session that sets one fails at
# setup with no audio. Leaving this unset is correct for that model.
#
# To reason more deeply, switch GEMINI_MODEL to gemini-3.8-live-extended-thinking,
# which is configured by level and whose only levels are low, medium and high.
# `minimal` is not one of them.
# GEMINI_THINKING_LEVEL=low
# GEMINI_INCLUDE_THOUGHTS=false
GEMINI_MAX_OUTPUT_TOKENS=1024
# Keep provider retries low; tune only after measuring latency.
GEMINI_CONNECT_MAX_RETRY=0
GEMINI_CONNECT_TIMEOUT=10
GEMINI_MAX_TOOL_STEPS=1
# Fallback when a session is dispatched without UI metadata.
LUMINE_INTERRUPTION_MODE=barge_in

# Legacy Groq/Silero/Cartesia settings, only for LUMINE_PIPELINE=legacy_cascade.
# The default pipeline above is `gemini_live`, so you do not need these unless you
# switch the cascade on.
# GROQ_API_KEY=
# CARTESIA_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Cartesia speech synthesis. The model is overridable so a deprecated model is a
# one-line change; the default must never be a retired model. See
# agent/providers.py for the curated list and agent/validation.py for the rules.
# sonic-2 was removed as a default because Cartesia retires it on 2026-10-20.
# CARTESIA_TTS_MODEL=sonic-3
# CARTESIA_TTS_VOICE=002622d8-19d0-4567-a16a-f99c7397c062
# CARTESIA_TTS_LANGUAGE=en
# CARTESIA_TTS_SPEED=0.95

# Voice LLM budget. Cap completion tokens so an ordinary reply cannot request
# thousands of tokens and trip the per-minute token limit.
#
# 900 is also the code default, and it is the floor that matters rather than the
# ceiling. `openai/gpt-oss-20b` is a *reasoning* model: it draws its thinking from
# this same budget, so a cap low enough to be "generous for a chat reply" leaves
# nothing to say the answer with. The result is a turn that produces an internal
# monologue and no audio, which is indistinguishable from a muted microphone. If
# you raise this, check the voice still starts.
GROQ_MAX_COMPLETION_TOKENS=900
GROQ_TEMPERATURE=0.7
# Provider-level retries, and LiveKit-level completion retries
# (attempts = GROQ_CONNECT_MAX_RETRY + 1). Both are clamped to 2 or lower.
GROQ_MAX_RETRIES=2
GROQ_CONNECT_MAX_RETRY=1

# Optional when Tauri should use a specific Python executable.
# LUMINE_PYTHON_BIN=C:\path\to\python.exe

# OpenAI. The plugin is installed and the settings screen will offer its models,
# but no default profile uses one, so this stays empty until you select an OpenAI
# model on the Language tab. The local-model provider under the same plugin needs
# no key at all and is not configured here.
# From https://platform.openai.com/api-keys
# OPENAI_API_KEY=

# Tool toggles for the voice agent. Tool ids live in agent/tools/tools_registry.py.
# LUMINE_DISABLED_TOOLS=weather,news
# LUMINE_ENABLE_APP_LAUNCH=false
